# Environment variables for Basha — Voice AI

# Google Gemini API Key (Required for server-side LLM inference)
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Optional: Groq API Key (Secondary fallback provider if configured)
# GROQ_API_KEY=your_groq_api_key_here

# Rate Limiting configuration
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=30
